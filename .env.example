# VYRAL STUDIO Environment Configuration Template

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME="VYRAL STUDIO"
APP_ENV=production
APP_URL=https://vyral-studio.netlify.app
API_BASE_URL=https://vyral-studio-backend.onrender.com/api

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database, Auth & Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key is STRICTLY used by the backend & background worker. NEVER expose on frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_STORAGE_BUCKET=vyral-media

# DIRECT DATABASE CONNECTION (PostgreSQL via PDO)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# AI PROVIDER INTEGRATIONS
# -----------------------------------------------------------------------------
# Google Gemini API (Script generation, Hook Lab, and Scene Segmentation)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ElevenLabs / Text-To-Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Image Generation / Asset Provider (Optional: Pexels / Unsplash / Fal.ai / OpenAI)
IMAGE_PROVIDER=curated_stock # options: curated_stock, fal_ai, dalle3
IMAGE_API_KEY=your-image-api-key-here

# -----------------------------------------------------------------------------
# BACKGROUND RENDERING WORKER (FFmpeg)
# -----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_POLL_INTERVAL_SEC=3
STORAGE_TEMP_DIR=/tmp/vyral_storage
MAX_CONCURRENT_JOBS=3

