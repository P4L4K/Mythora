# MYTHORA Environment Configuration Template

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME="MYTHORA"
APP_ENV=production
APP_URL=https://mythora.onrender.com
API_BASE_URL=https://mythora-api.onrender.com/api

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database, Auth & Permanent Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key is STRICTLY used by the backend & background worker. NEVER expose on frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_STORAGE_BUCKET=mythora-media

# DIRECT DATABASE CONNECTION (Supabase PostgreSQL via PDO)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API CONFIGURATION (Free-Tier Prioritized Models)
# -----------------------------------------------------------------------------
# Google AI Studio API Key (Create for free at: aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# 1. Primary Model: Fast, lightweight script generation, hooks & scene breakdown
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite

# 2. Refinement Model: Complex prompt & script refiner (fallback: 3.5 Flash Lite)
GEMINI_REFINE_MODEL=gemini-3.8-flash

# 3. Downloadable Audio TTS: Gemini Expressive TTS (fallback: Free Neural Edge TTS)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# -----------------------------------------------------------------------------
# STOCK IMAGERY (Zero Paid Image APIs)
# -----------------------------------------------------------------------------
# Optional: Unsplash Access Key for dynamic scene image lookup (Free at unsplash.com/developers)
# If left blank, curated high-resolution royalty-free imagery is automatically used.
UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# BACKGROUND RENDERING WORKER (FFmpeg on Render)
# -----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_POLL_INTERVAL_SEC=3
STORAGE_TEMP_DIR=/tmp/mythora_storage
